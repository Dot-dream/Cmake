{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "cortex-debug",
            "request": "launch",
            "name": "Debug JLink",
            "cwd": "${workspaceRoot}",
            "preLaunchTask": "CMake: build",
            "executable": "${workspaceRoot}/build/${workspaceRootFolderName}.elf",
            "serverpath": "${workspaceRoot}/tools/jlink/JLinkGDBServerCL.exe",
            "servertype": "jlink",
            "device": "YTM32B1MD14",
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceRoot}/.vscode/chip.svd",
            "rttConfig": {
                "enabled": true,
                "decoders": [{"port": 0, "type": "console"}]
            }
        }
    ]
}
