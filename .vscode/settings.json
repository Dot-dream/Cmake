{
    "cmake.cmakePath": "tools/cmake/bin/cmake.exe",
    "cmake.generator": "Ninja",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureArgs": [
        "-DCMAKE_MAKE_PROGRAM=${workspaceFolder}/tools/ninja/ninja.exe",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/gcc.cmake",
        "-DARM_CPU=cortex-m33"
    ]
}
